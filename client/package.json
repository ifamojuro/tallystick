{
  "name": "@tallystick/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench": "node --import ../server/src/node-libsodium-fix.mjs bench.ts",
    "e2e:setup": "playwright install chromium",
    "e2e": "npm run e2e:setup && node e2e.mjs",
    "e2e:full": "npm run e2e:setup && node e2e-full.mjs",
    "e2e:collab": "npm run e2e:setup && node e2e-collab.mjs",
    "e2e:recovery": "npm run e2e:setup && node e2e-recovery.mjs",
    "e2e:casework": "npm run e2e:setup && node e2e-casework.mjs"
  },
  "dependencies": {
    "@tallystick/shared": "*",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@tallystick/server": "*",
    "playwright": "^1.63.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "license": "AGPL-3.0-only"
}
